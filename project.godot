3d_physics/layer_2="Cuerpo jugador"
3d_physics/layer_3="Cuerpo enemigo"
3d_physics/layer_4="Hurtbox jugador"
3d_physics/layer_5="Hurtbox enemigo"
3d_physics/layer_6="Hitbox jugador"
3d_physics/layer_7="Hitbox enemigo"
3d_physics/layer_8="Interactuables"

[rendering]

environment/defaults/default_clear_color=Color(0, 0, 0, 1)
