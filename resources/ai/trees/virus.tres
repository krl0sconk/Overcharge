[gd_resource type="Resource" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/ai/components/Sequence.gd" id="Sequence"]
[ext_resource type="Script" path="res://scripts/ai/components/Selector.gd" id="Selector"]
[ext_resource type="Script" path="res://scripts/ai/components/AcquireTarget.gd" id="AcquireTarget"]
[ext_resource type="Script" path="res://scripts/ai/components/IsTargetInRange.gd" id="IsTargetInRange"]
[ext_resource type="Script" path="res://scripts/ai/components/TurnToTarget.gd" id="TurnToTarget"]
[ext_resource type="Script" path="res://scripts/ai/components/MoveToTarget.gd" id="MoveToTarget"]
[ext_resource type="Script" path="res://scripts/ai/components/Patrol.gd" id="Patrol"]

[sub_resource type="Resource" id="SR_acquire"]
script = ExtResource("AcquireTarget")
vision_range = 12.0

[sub_resource type="Resource" id="SR_range_chase"]
script = ExtResource("IsTargetInRange")
min_range = 0.0
max_range = 12.0

[sub_resource type="Resource" id="SR_turn"]
script = ExtResource("TurnToTarget")
turn_speed = 6.0

[sub_resource type="Resource" id="SR_move"]
script = ExtResource("MoveToTarget")
stop_distance = 0.5

[sub_resource type="Resource" id="SR_seq_chase"]
script = ExtResource("Sequence")
children = Array[Resource]([SubResource("SR_range_chase"), SubResource("SR_turn"), SubResource("SR_move")])

[sub_resource type="Resource" id="SR_patrol"]
script = ExtResource("Patrol")
leg_duration = 2.0

[sub_resource type="Resource" id="SR_selector"]
script = ExtResource("Selector")
children = Array[Resource]([SubResource("SR_seq_chase"), SubResource("SR_patrol")])

[resource]
script = ExtResource("Sequence")
children = Array[Resource]([SubResource("SR_acquire"), SubResource("SR_selector")])
