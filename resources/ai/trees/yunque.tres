[gd_resource type="Resource" load_steps=20 format=3]

[ext_resource type="Script" path="res://scripts/ai/components/Sequence.gd" id="Sequence"]
[ext_resource type="Script" path="res://scripts/ai/components/Selector.gd" id="Selector"]
[ext_resource type="Script" path="res://scripts/ai/components/AcquireTarget.gd" id="AcquireTarget"]
[ext_resource type="Script" path="res://scripts/ai/components/RecoverFromStun.gd" id="RecoverFromStun"]
[ext_resource type="Script" path="res://scripts/ai/components/ChargeForward.gd" id="ChargeForward"]
[ext_resource type="Script" path="res://scripts/ai/components/IsTargetBehind.gd" id="IsTargetBehind"]
[ext_resource type="Script" path="res://scripts/ai/components/TurnToTarget.gd" id="TurnToTarget"]
[ext_resource type="Script" path="res://scripts/ai/components/HasLineToTarget.gd" id="HasLineToTarget"]
[ext_resource type="Script" path="res://scripts/ai/components/BeginCharge.gd" id="BeginCharge"]

[sub_resource type="Resource" id="SR_acquire"]
script = ExtResource("AcquireTarget")
vision_range = 10.0

[sub_resource type="Resource" id="SR_recover"]
script = ExtResource("RecoverFromStun")
stun_duration = 1.5

[sub_resource type="Resource" id="SR_charge"]
script = ExtResource("ChargeForward")

[sub_resource type="Resource" id="SR_is_behind"]
script = ExtResource("IsTargetBehind")
behind_dot_threshold = -0.3

[sub_resource type="Resource" id="SR_turn"]
script = ExtResource("TurnToTarget")
turn_speed = 6.0
aligned_epsilon = 0.02

[sub_resource type="Resource" id="SR_seq_flank"]
script = ExtResource("Sequence")
children = Array[Resource]([SubResource("SR_is_behind"), SubResource("SR_turn")])

[sub_resource type="Resource" id="SR_has_line"]
script = ExtResource("HasLineToTarget")
facing_dot_threshold = 0.97
environment_mask = 1

[sub_resource type="Resource" id="SR_begin_charge"]
script = ExtResource("BeginCharge")
telegraph_duration = 0.6

[sub_resource type="Resource" id="SR_seq_charge_start"]
script = ExtResource("Sequence")
children = Array[Resource]([SubResource("SR_has_line"), SubResource("SR_begin_charge")])

[sub_resource type="Resource" id="SR_selector"]
script = ExtResource("Selector")
children = Array[Resource]([SubResource("SR_recover"), SubResource("SR_charge"), SubResource("SR_seq_flank"), SubResource("SR_seq_charge_start"), SubResource("SR_turn")])

[resource]
script = ExtResource("Sequence")
children = Array[Resource]([SubResource("SR_acquire"), SubResource("SR_selector")])
