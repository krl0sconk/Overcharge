[sub_resource type="Resource" id="SR_acquire"]
script = ExtResource("AcquireTarget")

[sub_resource type="Resource" id="SR_range_melee"]
script = ExtResource("IsTargetInRange")
max_range = 1.8

[sub_resource type="Resource" id="SR_melee"]
script = ExtResource("MeleeAttack")

[sub_resource type="Resource" id="SR_seq_melee"]
script = ExtResource("Sequence")
children = Array[ExtResource("1_p3tsq")]([SubResource("SR_range_melee"), SubResource("SR_melee")])

[sub_resource type="Resource" id="SR_cooldown_melee"]
