[sub_resource type="Resource" id="SR_acquire"]
script = ExtResource("AcquireTarget")
vision_range = 14.0

[sub_resource type="Resource" id="SR_ranged_continue"]
script = ExtResource("RangedAttack")
max_distance = 14.0

[sub_resource type="Resource" id="SR_range_close"]
script = ExtResource("IsTargetInRange")
max_range = 3.0

[sub_resource type="Resource" id="SR_melee"]
script = ExtResource("MeleeAttack")

[sub_resource type="Resource" id="SR_seq_melee"]
script = ExtResource("Sequence")
children = Array[ExtResource("1_rwjbc")]([SubResource("SR_range_close"), SubResource("SR_melee")])

[sub_resource type="Resource" id="SR_cooldown_melee"]
script = ExtResource("Cooldown")
cooldown = 1.5
children = Array[ExtResource("1_rwjbc")]([SubResource("SR_seq_melee")])

[sub_resource type="Resource" id="SR_range_far"]
script = ExtResource("IsTargetInRange")
min_range = 3.0
max_range = 14.0

[sub_resource type="Resource" id="SR_has_line"]
script = ExtResource("HasLineToTarget")

[sub_resource type="Resource" id="SR_begin_firing"]
script = ExtResource("BeginFiring")

[sub_resource type="Resource" id="SR_seq_ranged_start"]
script = ExtResource("Sequence")
children = Array[ExtResource("1_rwjbc")]([SubResource("SR_range_far"), SubResource("SR_has_line"), SubResource("SR_begin_firing")])

[sub_resource type="Resource" id="SR_cooldown_ranged"]
script = ExtResource("Cooldown")
cooldown = 2.5
children = Array[ExtResource("1_rwjbc")]([SubResource("SR_seq_ranged_start")])

[sub_resource type="Resource" id="SR_turn"]
script = ExtResource("TurnToTarget")
turn_speed = 1.5

[sub_resource type="Resource" id="SR_inner_selector"]
script = ExtResource("Selector")
children = Array[ExtResource("1_rwjbc")]([SubResource("SR_ranged_continue"), SubResource("SR_cooldown_melee"), SubResource("SR_cooldown_ranged"), SubResource("SR_turn")])

[sub_resource type="Resource" id="SR_seq_engage"]
script = ExtResource("Sequence")
children = Array[ExtResource("1_rwjbc")]([SubResource("SR_acquire"), SubResource("SR_inner_selector")])

[sub_resource type="Resource" id="SR_reload"]
script = ExtResource("Reload")

[resource]
script = ExtResource("Selector")
children = Array[ExtResource("1_rwjbc")]([SubResource("SR_seq_engage"), SubResource("SR_reload")])
